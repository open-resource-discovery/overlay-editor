{
  "name": "@open-resource-discovery/overlay-editor",
  "version": "0.2.1",
  "description": "React components for viewing and editing ORD Overlay 0.1 documents.",
  "keywords": [
    "ord",
    "open-resource-discovery",
    "overlay",
    "react",
    "viewer",
    "editor",
    "openapi",
    "csn",
    "mcp",
    "a2a"
  ],
  "author": "SAP SE",
  "license": "Apache-2.0",
  "homepage": "https://github.com/open-resource-discovery/overlay-editor#readme",
  "bugs": {
    "url": "https://github.com/open-resource-discovery/overlay-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-resource-discovery/overlay-editor.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./card-view": {
      "types": "./dist/card-view.d.ts",
      "import": "./dist/card-view.js",
      "default": "./dist/card-view.js"
    },
    "./styles": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "build": "npm run build:lib",
    "build:lib": "vite build --config vite.config.lib.ts && node scripts/strip-css-from-dts.mjs",
    "website:start": "npm --prefix website run start",
    "website:build": "npm --prefix website run build",
    "lint": "npm run eslint:ci",
    "eslint": "eslint . --fix",
    "eslint:ci": "eslint .",
    "prettier": "prettier --write \"**/*.{ts,tsx,json,yml,yaml,md,html,css}\"",
    "prettier:ci": "prettier --check \"**/*.{ts,tsx,json,yml,yaml,md,html,css}\"",
    "format": "npm run prettier && npm run eslint",
    "format:check": "npm run prettier:ci && npm run eslint:ci",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@open-resource-discovery/ui-components": "^0.1.3",
    "lucide-react": "^1.22.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@monaco-editor/react": "4.7.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsc-alias": "1.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.15.0",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "brace-expansion": "^1.1.18",
    "dompurify": "3.4.14",
    "js-yaml": ">=4.3.1",
    "postcss": "8.5.26",
    "undici": "7.29.0"
  }
}
